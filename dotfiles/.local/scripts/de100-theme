write_starship() {
    cat >"$THEME_STATE_DIR/starship.toml" <<EOF
"\$schema" = "https://starship.rs/config-schema.json"

add_newline = true
scan_timeout = 20
command_timeout = 800
palette = "$palette_name"

format = """
\$directory\\
\$git_branch\\
\$git_status\\
\$golang\\
\$nodejs\\
\$python\\
\$rust\\
\$cmd_duration\\
\$line_break\\
\$jobs\\
\$status\\
\$character"""

[palettes.$palette_name]
bg = "$bg"
fg = "$fg"
blue = "$blue"
cyan = "$cyan"
green = "$green"
orange = "$orange"
purple = "$purple"
red = "$red"
yellow = "$yellow"

[directory]
style = "bold blue"
truncation_length = 4
truncate_to_repo = false
read_only = " ro"

[git_branch]
format = "[\$symbol\$branch](\$style) "
symbol = "git:"
style = "purple"

[git_status]
format = "([\$all_status\$ahead_behind](\$style) )"
style = "yellow"
conflicted = "="
ahead = ">"
behind = "<"
diverged = "<>"
up_to_date = ""
untracked = "?"
stashed = "\$"
modified = "!"
staged = "+"
renamed = "r"
deleted = "x"

[cmd_duration]
min_time = 1000
format = "took [\$duration](\$style) "
style = "orange"

[status]
disabled = false
format = "[\$status](\$style) "
style = "red"

[character]
success_symbol = "[>](bold green)"
error_symbol = "[>](bold red)"

[golang]
format = "go [\$version](cyan) "

[nodejs]
format = "node [\$version](green) "

[python]
format = "py [\$version](yellow) "

[rust]
format = "rs [\$version](orange) "

[package]
disabled = true
EOF
}

set_theme() {
    local theme="$1"

    if ! theme_exists "$theme"; then
        echo "Unknown theme: $theme" >&2
        usage
        exit 1
    fi

    theme_values "$theme"
    mkdir -p "$THEME_STATE_DIR" "$CONFIG_HOME/kitty" "$CONFIG_HOME/ghostty"

    cat >"$CONFIG_HOME/kitty/local.conf" <<EOF
# Generated by de100-theme. Edit local.conf.example for manual overrides.
include themes/$kitty_theme
EOF

    cat >"$CONFIG_HOME/ghostty/local.ghostty" <<EOF
# Generated by de100-theme. Edit local.ghostty.example for manual overrides.
theme = $ghostty_theme
EOF

    cat >"$THEME_STATE_DIR/nvim.lua" <<EOF
${nvim_setup:+$nvim_setup
}vim.cmd.colorscheme("$nvim_theme")
EOF

    write_starship
    printf '%s\n' "$theme" >"$THEME_STATE_DIR/current"

    echo "Theme set to: $theme"
    echo "Reload or restart Kitty/Ghostty, open a new shell for Starship, and restart Neovim."
}

case "${1:-}" in
list)
    printf '%s\n' tokyo-night catppuccin-mocha rose-pine-moon gruvbox-dark evergarden-spring \
        vscode-dark vscode-light \
        everforest-dark-hard everforest-dark-medium everforest-dark-soft \
        everforest-light-hard everforest-light-medium everforest-light-soft \
        nightfox dayfox dawnfox duskfox nordfox terafox carbonfox
    ;;
current)
    if [[ -r "$THEME_STATE_DIR/current" ]]; then
        cat "$THEME_STATE_DIR/current"
    else
        echo "tokyo-night (default)"
    fi
    ;;
set)
    if [[ $# -ne 2 ]]; then
        usage
        exit 1
    fi
    set_theme "$2"
    ;;
-h | --help | help | "")
    usage
    ;;
*)
    echo "Unknown command: $1" >&2
    usage
    exit 1
    ;;
esac
