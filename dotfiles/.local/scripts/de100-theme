#!/usr/bin/env bash

# Switch the dev-setup visual profile across Kitty, Ghostty, Starship, and Neovim.

set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
THEME_STATE_DIR="$STATE_HOME/de100/theme"

usage() {
    cat <<'EOF'
Usage:
  de100-theme list
  de100-theme current
  de100-theme set <theme>

Themes:
  tokyo-night
  catppuccin-mocha
  rose-pine-moon
  gruvbox-dark
  evergarden-spring
  vscode-dark
  vscode-light
  everforest-dark-hard
  everforest-dark-medium
  everforest-dark-soft
  everforest-light-hard
  everforest-light-medium
  everforest-light-soft
  nightfox
  dayfox
  dawnfox
  duskfox
  nordfox
  terafox
  carbonfox

Notes:
  - Restart terminals or reload their config after switching.
  - Neovim reads the new theme on next start; run :colorscheme manually for live changes.
EOF
}

theme_exists() {
    case "$1" in
    tokyo-night | catppuccin-mocha | rose-pine-moon | gruvbox-dark | evergarden-spring | \
        vscode-dark | vscode-light | \
        everforest-dark-hard | everforest-dark-medium | everforest-dark-soft | \
        everforest-light-hard | everforest-light-medium | everforest-light-soft | \
        nightfox | dayfox | dawnfox | duskfox | nordfox | terafox | carbonfox)
        return 0
        ;;
    *)
        return 1
        ;;
    esac
}

