#!/usr/bin/env bash

# Switch the mfansible visual profile across Kitty, Ghostty, Starship, and Neovim.

set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
THEME_STATE_DIR="$STATE_HOME/de100/theme"

usage() {
    cat <<'EOF'
Usage:
  de100-theme list
  de100-theme current
  de100-theme set <theme>

Themes:
  tokyo-night
  catppuccin-mocha
  rose-pine-moon
  gruvbox-dark
  evergarden-spring

Notes:
  - Restart terminals or reload their config after switching.
  - Neovim reads the new theme on next start; run :colorscheme manually for live changes.
EOF
}

theme_exists() {
    case "$1" in
    tokyo-night | catppuccin-mocha | rose-pine-moon | gruvbox-dark | evergarden-spring)
        return 0
        ;;
    *)
        return 1
        ;;
    esac
}

theme_values() {
    case "$1" in
    tokyo-night)
        kitty_theme="tokyo-night.conf"
        ghostty_theme="tokyo-night"
        nvim_theme="tokyonight-night"
        palette_name="tokyo_night"
        bg="#1a1b26"
        fg="#c0caf5"
        blue="#7aa2f7"
        cyan="#7dcfff"
        green="#9ece6a"
        orange="#ff9e64"
        purple="#bb9af7"
        red="#f7768e"
        yellow="#e0af68"
        ;;
    catppuccin-mocha)
        kitty_theme="catppuccin-mocha.conf"
        ghostty_theme="catppuccin-mocha"
        nvim_theme="catppuccin-mocha"
        palette_name="catppuccin_mocha"
        bg="#1e1e2e"
        fg="#cdd6f4"
        blue="#89b4fa"
        cyan="#94e2d5"
        green="#a6e3a1"
        orange="#fab387"
        purple="#cba6f7"
        red="#f38ba8"
        yellow="#f9e2af"
        ;;
    rose-pine-moon)
        kitty_theme="rose-pine-moon.conf"
        ghostty_theme="rose-pine-moon"
        nvim_theme="rose-pine-moon"
        palette_name="rose_pine_moon"
        bg="#232136"
        fg="#e0def4"
        blue="#9ccfd8"
        cyan="#3e8fb0"
        green="#3e8fb0"
        orange="#ea9a97"
        purple="#c4a7e7"
        red="#eb6f92"
        yellow="#f6c177"
        ;;
    gruvbox-dark)
        kitty_theme="gruvbox-dark.conf"
        ghostty_theme="gruvbox-dark"
        nvim_theme="gruvbox"
        palette_name="gruvbox_dark"
        bg="#282828"
        fg="#ebdbb2"
        blue="#83a598"
        cyan="#8ec07c"
        green="#b8bb26"
        orange="#fe8019"
        purple="#d3869b"
        red="#fb4934"
        yellow="#fabd2f"
        ;;
    evergarden-spring)
        kitty_theme="tokyo-night.conf"
        ghostty_theme="tokyo-night"
        nvim_theme="evergarden-spring"
        palette_name="evergarden_spring"
        bg="#20251d"
        fg="#dddecf"
        blue="#8da3b9"
        cyan="#93c9a1"
        green="#b2c98f"
        orange="#e69875"
        purple="#d6a0d1"
        red="#e67e80"
        yellow="#dbbc7f"
        ;;
    esac
}

write_starship() {
    cat >"$THEME_STATE_DIR/starship.toml" <<EOF
"\$schema" = "https://starship.rs/config-schema.json"

add_newline = true
scan_timeout = 20
command_timeout = 800
palette = "$palette_name"

format = """
\$directory\\
\$git_branch\\
\$git_status\\
\$golang\\
\$nodejs\\
\$python\\
\$rust\\
\$cmd_duration\\
\$line_break\\
\$jobs\\
\$status\\
\$character"""

[palettes.$palette_name]
bg = "$bg"
fg = "$fg"
blue = "$blue"
cyan = "$cyan"
green = "$green"
orange = "$orange"
purple = "$purple"
red = "$red"
yellow = "$yellow"

[directory]
style = "bold blue"
truncation_length = 4
truncate_to_repo = false
read_only = " ro"

[git_branch]
format = "[\$symbol\$branch](\$style) "
symbol = "git:"
style = "purple"

[git_status]
format = "([\$all_status\$ahead_behind](\$style) )"
style = "yellow"
conflicted = "="
ahead = ">"
behind = "<"
diverged = "<>"
up_to_date = ""
untracked = "?"
stashed = "\$"
modified = "!"
staged = "+"
renamed = "r"
deleted = "x"

[cmd_duration]
min_time = 1000
format = "took [\$duration](\$style) "
style = "orange"

[status]
disabled = false
format = "[\$status](\$style) "
style = "red"

[character]
success_symbol = "[>](bold green)"
error_symbol = "[>](bold red)"

[golang]
format = "go [\$version](cyan) "

[nodejs]
format = "node [\$version](green) "

[python]
format = "py [\$version](yellow) "

[rust]
format = "rs [\$version](orange) "

[package]
disabled = true
EOF
}

set_theme() {
    local theme="$1"

    if ! theme_exists "$theme"; then
        echo "Unknown theme: $theme" >&2
        usage
        exit 1
    fi

    theme_values "$theme"
    mkdir -p "$THEME_STATE_DIR" "$CONFIG_HOME/kitty" "$CONFIG_HOME/ghostty"

    cat >"$CONFIG_HOME/kitty/local.conf" <<EOF
# Generated by de100-theme. Edit local.conf.example for manual overrides.
include themes/$kitty_theme
EOF

    cat >"$CONFIG_HOME/ghostty/local.ghostty" <<EOF
# Generated by de100-theme. Edit local.ghostty.example for manual overrides.
theme = $ghostty_theme
EOF

    cat >"$THEME_STATE_DIR/nvim.lua" <<EOF
vim.cmd.colorscheme("$nvim_theme")
EOF

    write_starship
    printf '%s\n' "$theme" >"$THEME_STATE_DIR/current"

    echo "Theme set to: $theme"
    echo "Reload or restart Kitty/Ghostty, open a new shell for Starship, and restart Neovim."
}

case "${1:-}" in
list)
    printf '%s\n' tokyo-night catppuccin-mocha rose-pine-moon gruvbox-dark evergarden-spring
    ;;
current)
    if [[ -r "$THEME_STATE_DIR/current" ]]; then
        cat "$THEME_STATE_DIR/current"
    else
        echo "tokyo-night (default)"
    fi
    ;;
set)
    if [[ $# -ne 2 ]]; then
        usage
        exit 1
    fi
    set_theme "$2"
    ;;
-h | --help | help | "")
    usage
    ;;
*)
    echo "Unknown command: $1" >&2
    usage
    exit 1
    ;;
esac
