#!/usr/bin/env bash

set -euo pipefail

hooks=(
    "$PWD/.ready-tmux"
    "$PWD/.ready-tmux.sh"
    "$HOME/.ready-tmux"
    "$HOME/.ready-tmux.sh"
)

for hook in "${hooks[@]}"; do
    if [[ -x "$hook" ]]; then
        "$hook"
        echo "Ran $hook"
        exit 0
    fi
done

echo "No .ready-tmux hook found"
