#!/usr/bin/env bash
echo "------------------- dev-env/neovim -------------------"
set -e
set -x

# Use nightly instead of latest stable
NEOVIM_VERSION="nightly"
echo "📡 Using Neovim version: $NEOVIM_VERSION"

echo "🖼️ Adding ascii-image-converter apt repository..."
echo 'deb [trusted=yes] https://apt.fury.io/ascii-image-converter/ /' | \
sudo tee /etc/apt/sources.list.d/ascii-image-converter.list >/dev/null

echo "🔽 Cloning Neovim repository..."
NEOVIM_DIR="$HOME/personal/neovim"
rm -rf "$NEOVIM_DIR"
git clone \
--depth 1 \
--branch "$NEOVIM_VERSION" \
https://github.com/neovim/neovim.git \
"$NEOVIM_DIR"
echo "✓ Repository cloned"

echo "📚 Installing build and image dependencies..."
sudo apt update
sudo apt install -y \
ninja-build gettext cmake unzip curl \
build-essential lldb git lua5.1 liblua5.1-0-dev luarocks \
imagemagick ascii-image-converter
echo "✓ Dependencies installed"

echo "🔨 Building Neovim..."
cd "$NEOVIM_DIR"
if ! make CMAKE_BUILD_TYPE=RelWithDebInfo; then
    echo "❌ Build failed! See https://github.com/neovim/neovim/blob/$NEOVIM_VERSION/BUILD.md"
    exit 1
fi
echo "✓ Build complete"

echo "⚙️ Installing Neovim system-wide..."
sudo make install
echo "✓ Neovim installed!"

# 🌳 tree-sitter CLI (needed by nvim-treesitter main branch)
if ! command -v tree-sitter >/dev/null 2>&1; then
    echo "🌳 Installing tree-sitter CLI..."
    if command -v cargo >/dev/null 2>&1; then
        cargo install tree-sitter-cli
        elif command -v npm >/dev/null 2>&1; then
        sudo npm install -g tree-sitter-cli
    else
        echo "⚠️  Install cargo or npm to get tree-sitter-cli"
    fi
fi

echo "🎉 Done! Run 'nvim --version' to verify"
